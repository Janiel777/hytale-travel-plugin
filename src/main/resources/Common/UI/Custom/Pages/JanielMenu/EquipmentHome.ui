$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 800, Height: 720);

  #Title {
    Group {
      $C.@Title {
        @Text = "EQUIPMENT";
      }

      $C.@HeaderSearch {}
    }
  }

  #Content {
    LayoutMode: Left;
    Padding: (Full: 10);

    Group #ElementList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }
  }
}

$C.@BackButton {}