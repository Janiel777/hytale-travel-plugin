$T = "JanielTheme.ui";

Button #Button {
  Padding: (Full: 10);
  LayoutMode: Left;

  Style: (
    Hovered: (
      Background: $T.@EntryHoverBg,
    )
  );

  Group #Icon {
    Anchor: (Width: 48, Height: 48);
    Background: $T.@IconBg;
  }

  Group {
    Anchor: (Width: 12);
  }

  Group {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #Name {
      Style: (RenderBold: true);
    }

    Label #Description {
      Style: (TextColor: $T.@MutedText);
    }

    Group {
      Anchor: (Height: 6);
    }

    Group #TagPill {
      Padding: (Left: 8, Right: 8, Top: 3, Bottom: 3);
      Background: $T.@PillBg;

      Label #Tag {
        Style: (TextColor: $T.@TagText);
      }
    }
  }
}