Button #Button {
  Padding: (Full: 10);
  LayoutMode: Left;

  Style: (
    Hovered: (
      Background: #000000(0.2),
    )
  );

  Group #Icon {
    Anchor: (Width: 48, Height: 48);
    Background: #000000(0.25);
  }

  Group {
    Anchor: (Width: 12);
  }

  Group {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #Name {
      Style: (RenderBold: true);
    }

    Label #Description {
      Style: (TextColor: #ffffff(0.6));
    }

    Group {
      Anchor: (Height: 6);
    }

    Group {
      LayoutMode: Left;

      Group #LevelPill {
        Padding: (Left: 8, Right: 8, Top: 3, Bottom: 3);
        Background: #000000(0.25);

        Label #Level {
          Style: (TextColor: #ffffff(0.75));
        }
      }

      Group {
        Anchor: (Width: 8);
      }

      Group #ProgressPill {
        Padding: (Left: 8, Right: 8, Top: 3, Bottom: 3);
        Background: #000000(0.25);

        Label #Progress {
          Style: (TextColor: #ffffff(0.75));
        }
      }
    }
  }
}